# Wajib untuk fitur Identifikasi Penyakit (Gemini)
# Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Kuota analisis
# Batas per klien (cookie anonim / IP) per hari
CLIENT_DAILY_SCAN_LIMIT=10
# Alias lama (masih didukung bila CLIENT_DAILY_SCAN_LIMIT kosong)
DAILY_SCAN_LIMIT=10
# Batas global per hari (pemutus sirkuit; 429 jika terlampaui)
GLOBAL_DAILY_SCAN_LIMIT=300

# Cookie anonim httpOnly bertanda tangan HMAC.
# Bila kosong, identitas klien hanya berbasis IP.
ANON_COOKIE_SECRET=

# Cloudflare Turnstile (opsional). Bila kosong, verifikasi dilewati.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (opsional, via Vercel Marketplace).
# Bila kosong, rate limit memakai memori serverless (lihat README).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
