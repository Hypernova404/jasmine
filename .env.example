# Wajib untuk fitur Identifikasi Penyakit (Gemini)
# Dapatkan di https://aistudio.google.com/apikey
# Bisa banyak key dipisah koma, atau GEMINI_API_KEY_1, GEMINI_API_KEY_2, ...
# App akan round-robin & fallback otomatis bila kena limit/429/503/404 model.
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash

# Identifikasi TANPA batas kuota — semua biaya Gemini ada di GEMINI_API_KEY.
